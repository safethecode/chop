+// Chop's sole extension: load its bundled defaults without changing the
+// user's Ghostty config location or the host process's command-line args.
+export fn chop_ghostty_config_load_file(self: *Config, path: [*:0]const u8) bool {
+    self.loadFile(state.alloc, std.mem.span(path)) catch return false;
+    return true;
+}
