+    pub fn handleChopProgramStatus(self: *StreamHandler, report: terminal.osc.Command.ChopProgramStatus) !void {
+        const value = std.mem.trim(u8, report.value, " \t\r\n");
+        if (std.mem.eql(u8, value, "?")) {
+            self.messageWriter(.{ .write_stable = switch (report.terminator) {
+                .bel => "\x1b]7501;?:states=idle,working,done,blocked,error:kinds=permission,question,auth\x07",
+                .st => "\x1b]7501;?:states=idle,working,done,blocked,error:kinds=permission,question,auth\x1b\\",
+            } });
+            return;
+        }
+        if (value.len > 4087) return;
+        self.surfaceMessageWriter(.{ .chop_program_status = .{
+            .event = .report,
+            .data = try apprt.surface.Message.WriteReq.init(self.alloc, value),
+        } });
     }
 
