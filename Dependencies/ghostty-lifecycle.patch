+//! Teardown queue drain, adapted for Zig 0.14.1 from Ghostty PR #14444.
+//! Upstream commit: 3cc748e676cf7fdd5e3d2ca48caf316415354069 (MIT).
+const std = @import("std");
+
+/// Drain only while the normal consumer joins its producers. Never dispatch
+/// native UI actions here; the handler owns or defers each popped message.
+pub fn QueueDrain(
+    comptime Queue: type,
+    comptime Context: type,
+    comptime handle: fn (Context, Value(Queue)) void,
+) type {
+    return struct {
+        const Self = @This();
+        const capacity = @typeInfo(@TypeOf(@as(Queue, undefined).data)).array.len;
+        queue: *Queue,
+        context: Context,
+        stop: std.atomic.Value(bool) = std.atomic.Value(bool).init(false),
+        thread: ?std.Thread = null,
+
+        pub fn start(self: *Self) void {
+            self.thread = std.Thread.spawn(.{}, run, .{self}) catch |err| {
+                std.log.err("queue drain spawn failed err={}", .{err});
+                return;
+            };
+        }
+
+        pub fn finish(self: *Self) void {
+            const thread = self.thread orelse return;
+            self.stop.store(true, .release);
+            thread.join();
+            self.thread = null;
+        }
+
+        fn run(self: *Self) void {
+            while (true) {
+                const stopping = self.stop.load(.acquire);
+                // A bounded FIFO pass releases every item queued before finish,
+                // even if other live surfaces keep producing indefinitely.
+                for (0..capacity) |_| {
+                    const value = self.queue.pop() orelse break;
+                    handle(self.context, value);
+                }
+                if (stopping) return;
+                std.Thread.sleep(std.time.ns_per_ms);
+            }
+        }
+    };
+}
+
+fn Value(comptime Queue: type) type {
+    return @typeInfo(@TypeOf(@as(Queue, undefined).data)).array.child;
+}
+
+test "drain releases a blocked producer and preserves FIFO" {
+    const Q = @import("blocking_queue.zig").BlockingQueue(u64, 4);
+    var queue: Q = .{};
+    const Seen = struct {
+        values: [5]u64 = undefined,
+        len: usize = 0,
+        fn handle(self: *@This(), value: u64) void {
+            self.values[self.len] = value;
+            self.len += 1;
+        }
+        fn produce(q: *Q) void { _ = q.push(5, .{ .forever = {} }); }
+    };
+    var seen: Seen = .{};
+    for (1..5) |i| try std.testing.expect(queue.push(i, .{ .instant = {} }) > 0);
+    const producer = try std.Thread.spawn(.{}, Seen.produce, .{&queue});
+    var drain: QueueDrain(Q, *Seen, Seen.handle) = .{ .queue = &queue, .context = &seen };
+    drain.start();
+    producer.join();
+    drain.finish();
+    try std.testing.expect(queue.pop() == null);
+    try std.testing.expectEqualSlices(u64, &.{ 1, 2, 3, 4, 5 }, seen.values[0..seen.len]);
+}
