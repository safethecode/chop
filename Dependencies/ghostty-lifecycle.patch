+fn chopProcessMessage(self: *App, rt_app: *apprt.App, message: Message) !bool {
+    log.debug("mailbox message={s}", .{@tagName(message)});
+    switch (message) {
+        .open_config => try self.performAction(rt_app, .open_config),
+        .new_window => |msg| try self.newWindow(rt_app, msg),
+        .close => |surface| self.closeSurface(surface),
+        .surface_message => |msg| try self.surfaceMessage(msg.surface, msg.message),
+        .redraw_surface => |surface| try self.redrawSurface(rt_app, surface),
+        .redraw_inspector => |surface| self.redrawInspector(rt_app, surface),
+        .quit => {
+            try self.performAction(rt_app, .quit);
+            return false;
+        },
+    }
+    return true;
+}
+
+/// Adapted from Ghostty PR #14444. Keep UI callbacks on the app thread.
+pub const ChopTeardownDrain = @import("datastruct/main.zig").QueueDrain(
+    Mailbox.Queue, ChopTeardown, ChopTeardown.keep,
+);
+
+pub fn chopTeardownDrain(self: *App, surface: *const Surface) ChopTeardownDrain {
+    const context: ChopTeardown = .{ .app = self, .surface = surface, .rt_surface = surface.rt_surface };
+    // A previous close may already have deferred messages for this surface.
+    // Remove those too before its address can be reused for a new surface.
+    var write: usize = self.chop_deferred_head;
+    for (self.chop_deferred.items[self.chop_deferred_head..]) |message| {
+        if (context.retained(message)) |kept| {
+            self.chop_deferred.items[write] = kept;
+            write += 1;
+        }
+    }
+    self.chop_deferred.items.len = write;
+    return .{ .queue = &self.mailbox, .context = context };
+}
+
+const ChopTeardown = struct {
+    app: *App,
+    surface: *const Surface,
+    rt_surface: *const apprt.Surface,
+
+    fn retained(self: ChopTeardown, message: Message) ?Message {
+        var kept = message;
+        const closing = switch (kept) {
+            .close => |v| v == self.surface,
+            .surface_message => |v| v.surface == self.surface,
+            .redraw_surface, .redraw_inspector => |v| v == self.rt_surface,
+            .new_window => |*v| new_window: {
+                if (v.parent == self.surface) v.parent = null;
+                break :new_window false;
             },
+            .open_config, .quit => false,
+        };
+        if (closing) {
+            chopDiscardMessage(kept);
+            return null;
         }
+        return kept;
+    }
+
+    fn keep(self: ChopTeardown, message: Message) void {
+        const kept = self.retained(message) orelse return;
+        self.app.chop_deferred.append(self.app.alloc, kept) catch {
+            chopDiscardMessage(kept);
+            log.err("unable to retain app message during teardown", .{});
+        };
+    }
+};
+
+fn chopDiscardMessage(message: Message) void {
+    switch (message) {
+        .surface_message => |v| switch (v.message) {
+            .clipboard_write => |write| write.req.deinit(),
+            .pwd_change => |write| write.deinit(),
+            else => {},
+        },
+        else => {},
     }
 }
 
